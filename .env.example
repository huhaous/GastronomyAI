# LLM provider: "local" (Ollama) or "openai"
LLM_PROVIDER=local

# --- Local Ollama (default) ---
# Start with: ollama serve   (binary: ~/.local/bin/ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:32b
# Fast fallback (Studio UI can also switch):
# OLLAMA_MODEL=qwen2.5:14b
# Optional: set true if your Ollama build supports OpenAI json_schema
# OLLAMA_STRICT_JSON_SCHEMA=false
# OLLAMA_API_KEY=ollama

# --- Cloud OpenAI (Path A host) ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Site lock (required in production) ---
# SITE_PASSWORD=
# Local `next dev` reads .env.local. The hosted URL reads Vercel env — edit
# SITE_PASSWORD there and redeploy. A new password invalidates every session.

# --- Studio surface ---
# Production defaults to coach (Elevate only). Local `next dev` is the lab.
# NEXT_PUBLIC_STUDIO_RESEARCH=true
# NEXT_PUBLIC_STUDIO_RESEARCH=false

# --- Graph coverage log ---
# One record per generation; `npm run coverage` summarizes the backlog.
# Locally this appends to var/coverage.jsonl with no configuration.
# COVERAGE_LOG=off
# COVERAGE_LOG_PATH=var/coverage.jsonl
#
# Hosted, there is no writable disk, so records need a store or they are lost.
# Create a PRIVATE Blob store (Vercel → Storage → Blob → access: Private) and
# connect it to the project; Vercel then injects BLOB_READ_WRITE_TOKEN itself.
# Private matters: a record carries the craving the diner typed.
# Set it here too so `npm run coverage:pull` can read the store from a laptop.
# BLOB_READ_WRITE_TOKEN=
# With no store configured, a production deploy falls back to console logging.

# Supabase (Auth + Postgres — Path B)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
